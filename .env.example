# Copy this file to .env and change the values:  cp .env.example .env

# Your domain without https:// (used by Caddy for the HTTPS certificate)
DOMAIN=example.com

# Full public address of the site (used for SEO tags, sitemap and link previews)
SITE_URL=https://example.com

# Port for the HTTP-only setup (docker-compose.yml)
HTTP_PORT=80
