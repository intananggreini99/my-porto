# Caddy gets and renews the HTTPS certificate for {$DOMAIN} automatically.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy web:80
	header Strict-Transport-Security "max-age=31536000"
}

# Optional: redirect www to the bare domain. Uncomment only after you
# create a DNS record for www that points to the same VPS IP.
